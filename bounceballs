
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Phaser Spinning Globes</title>
    https://cdn.jsdelivr.net/npm/phaser@3/dist/phaser.js</script>
    <style>
        body { margin: 0; }
        #controls {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(255,255,255,0.8);
            padding: 10px;
            border-radius: 8px;
        }
    </style>
</head>
<body>
<div id="controls">
    <label>Speed: <input type="range" id="speedSlider" min="0.1" max="5" step="0.1" value="1"></label>
    <button id="addGlobe">Add Globe</button>
</div>
<script>
class GlobeScene extends Phaser.Scene {
    constructor() {
        super('GlobeScene');
    }

    preload() {
        // Use any globe image or placeholder
        this.load.image('globe', 'https://upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Globe_icon.svg/512px-Globe_icon.svg.png');
    }

    create() {
        this.globes = [];
        this.speedFactor = 1;

        // Create two initial globes
        this.addGlobe(100, 100);
        this.addGlobe(400, 300);

        // Slider control
        document.getElementById('speedSlider').addEventListener('input', (e) => {
            this.speedFactor = parseFloat(e.target.value);
        });

        // Button to add globe
        document.getElementById('addGlobe').addEventListener('click', () => {
            const x = Phaser.Math.Between(50, this.sys.game.config.width - 50);
            const y = Phaser.Math.Between(50, this.sys.game.config.height - 50);
            this.addGlobe(x, y);
        });
    }

    addGlobe(x, y) {
        const globe = this.physics.add.image(x, y, 'globe').setScale(0.3);
        globe.setBounce(1).setCollideWorldBounds(true);
        globe.setVelocity(Phaser.Math.Between(-200, 200), Phaser.Math.Between(-200, 200));
        globe.rotationSpeed = Phaser.Math.FloatBetween(0.01, 0.05);
        this.globes.push(globe);
    }

    update() {
        this.globes.forEach(globe => {
            globe.rotation += globe.rotationSpeed * this.speedFactor;
            globe.body.velocity.x *= this.speedFactor;
            globe.body.velocity.y *= this.speedFactor;
        });
    }
}

const config = {
    type: Phaser.AUTO,
    width: 800,
    height: 600,
    backgroundColor: '#222',
    physics: {
        default: 'arcade',
        arcade: { gravity: { y: 0 }, debug: false }
    },
    scene: GlobeScene
};

new Phaser.Game(config);
</script>
</body>
</html>
